# Copy to .env (never commit .env). NCTE reads OPENROUTER_API_KEY from the environment or ./.env
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: OpenRouter through fal (keep secrets local)
# FAL_KEY=your-fal-key
# NCTE_LLM_PROVIDER=fal

# Optional: the Gemini API directly (a Google AI Studio key; billed by Google per use)
# GEMINI_API_KEY=your-google-ai-studio-key
# NCTE_LLM_PROVIDER=gemini
